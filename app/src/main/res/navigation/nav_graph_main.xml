<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph.xml"
    app:startDestination="@id/fragment_record">

    <!-- MAP -->
    <fragment
        android:id="@+id/fragment_record"
        android:name="net.voussoir.trkpt.fragments.RecordFragment"
        android:label="Map"
        tools:layout="@layout/fragment_record">
        <action
            android:id="@+id/action_map_fragment_to_settings_fragment"
            app:destination="@id/fragment_settings" />
        <action
            android:id="@+id/action_map_fragment_to_tracks_fragment"
            app:destination="@id/fragment_history" />
    </fragment>

    <!-- SETTINGS -->
    <fragment
        android:id="@+id/fragment_settings"
        android:name="net.voussoir.trkpt.fragments.SettingsFragment"
        android:label="Settings"/>

    <!-- TRACKS (LIST OF TRACKS) -->
    <fragment
        android:id="@+id/fragment_history"
        android:name="net.voussoir.trkpt.fragments.TracklistFragment"
        android:label="Tracks"
        tools:layout="@layout/fragment_tracklist">
        <action
            android:id="@+id/action_tracks_fragment_to_fragment_track"
            app:destination="@id/fragment_track"
            app:popUpToInclusive="false" />

    </fragment>

    <!-- TRACK -->
    <fragment
        android:id="@+id/fragment_track"
        android:name="net.voussoir.trkpt.fragments.TrackFragment"
        android:label="Track"
        tools:layout="@layout/fragment_track" >
        <argument
            android:name="delete_track_id"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

</navigation>
